PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://usuario:clave@host/db?sslmode=require
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=cambia-esto-por-un-texto-largo-aleatorio
