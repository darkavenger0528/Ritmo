GEMINI_API_KEY=
# Rutas TransMilenio/SITP (opcional): clave de Google Maps con Routes API habilitada
GOOGLE_MAPS_KEY=
# Modo demo para presentaciones: muestra el botón «Ver demo» sin iniciar sesión
DEMO_MODE=false
